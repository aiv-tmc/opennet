#!/sbin/openrc-run
# OpenNet daemon service for OpenRC.

name="OpenNet daemon"
description="Peer-to-peer compute daemon"

command=/usr/local/bin/opennetd
command_background=true
pidfile=/run/opennet/opennetd.pid
output_log=/var/log/opennetd.log
error_log=/var/log/opennetd.log
start_stop_daemon_args="--chdir /"

depend() {
    need net
    after firewall
}
